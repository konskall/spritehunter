# Optional paid provider. Keep both values server-side; never prefix with NEXT_PUBLIC_.
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=

# Required only when an authenticated scheduler endpoint is added/enabled.
CRON_SECRET=

# Future Web Push support. Generate outside the repository and keep the private key secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional email delivery provider for a future server notification worker.
EMAIL_API_KEY=
EMAIL_FROM=

