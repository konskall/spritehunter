# Optional providers. Server-side only; never prefix these with NEXT_PUBLIC_.
# Vaisala Xweather: +CG lightning polarity and peak current (https://data.portal.xweather.com/account/keys)
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=
# WeatherAPI.com: second forecast for the observer's sky (https://www.weatherapi.com/my/)
WEATHERAPI_KEY=
# OpenWeatherMap: third forecast for the observer's sky (https://home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY=

# Public site address, only needed with a custom domain (Vercel's production URL is used otherwise).
SITE_URL=
